<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootFrameLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    tools:context=".MainActivity">

    <org.maplibre.android.maps.MapView
        android:id="@+id/mapview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/trackingModeSwitch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:background="#80FFFFFF"
        android:contentDescription="Toggle Auto/Manual Tracking Mode"
        android:padding="8dp"
        android:text="Auto"
        android:textColor="?android:attr/textColorPrimary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/setNorthButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Reset North Orientation"
        android:padding="8dp"
        android:src="@drawable/ic_north"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/trackingModeSwitch"
        app:layout_constraintTop_toBottomOf="@id/trackingModeSwitch"
        app:tint="@color/black"
        tools:visibility="visible" />


    <ImageView
        android:id="@+id/transportModeIcon"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:clickable="true"
        android:contentDescription="Current Transport Mode / Override"
        android:focusable="true"
        android:padding="6dp"
        android:scaleType="fitCenter"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:srcCompat="@drawable/ic_walking"
        tools:visibility="visible" />

    <Button
        android:id="@+id/gpsStatusButton"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/circle_button"
        android:backgroundTint="@android:color/holo_red_light"
        android:contentDescription="GPS Status Indicator"
        android:text="🛰"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/trackingStatusTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="#A0FFFFFF"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/transportModeIcon"
        app:layout_constraintTop_toBottomOf="@id/transportModeIcon"
        tools:text="Tracking: Walking"
        tools:visibility="visible" />


    <LinearLayout
        android:id="@+id/bottomControlsLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        android:gravity="center_vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/recenterButton"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@drawable/circle_button"
            android:backgroundTint="@color/black"
            android:contentDescription="Recenter Map"
            android:text="⤵"
            android:textColor="@android:color/white"
            android:textSize="18sp" />

        <Button
            android:id="@+id/viewJourneysButton"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/circle_button"
            android:backgroundTint="@color/black"
            android:contentDescription="View Saved Journeys"
            android:text="List"
            android:textColor="@android:color/white"
            android:textSize="14sp" /> <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

        <ImageButton
            android:id="@+id/activityInfoButton"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/circle_button"
            android:backgroundTint="#FF9800"
            android:contentDescription="Show Activity Confidences"
            android:elevation="6dp"
            android:src="@android:drawable/ic_dialog_info"
            app:tint="@android:color/white" />

        <Button
            android:id="@+id/btnToggleHeatmap"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/circle_button"
            android:backgroundTint="#FF9800"
            android:contentDescription="Toggle Heatmap/Polylines"
            android:text="🔥"
            android:textColor="@android:color/white"
            android:textSize="18sp" />

        <Button
            android:id="@+id/settingsButton"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@drawable/circle_button"
            android:backgroundTint="@color/black"
            android:contentDescription="Open Settings"
            android:text="⚙"
            android:textColor="@android:color/white"
            android:textSize="18sp"/>

    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/startStopFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:clickable="true"
        android:contentDescription="Start or Stop Tracking"
        android:focusable="true"
        android:visibility="gone"
        app:backgroundTint="?attr/colorPrimary"
        app:elevation="6dp"
        app:fabSize="normal"
        app:layout_constraintBottom_toTopOf="@id/bottomControlsLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:pressedTranslationZ="12dp"
        app:srcCompat="@drawable/ic_play"
        app:tint="@android:color/white"
        tools:visibility="visible" />


    <androidx.cardview.widget.CardView
        android:id="@+id/journeyDetailsPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:clickable="true"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_bottom_journey_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="?android:attr/textAppearanceLarge"
                    android:textStyle="bold"
                    tools:text="Morning Walk" />

                <ImageButton
                    android:id="@+id/btnEditJourneyName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Edit Journey Name"
                    android:padding="8dp"
                    android:src="@android:drawable/ic_menu_edit" />

                <ImageButton
                    android:id="@+id/btnCloseDetailsPanel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Close Details"
                    android:src="@android:drawable/ic_menu_close_clear_cancel" />

            </LinearLayout>

            <TextView
                android:id="@+id/tv_bottom_journey_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"
                android:textAppearance="?android:attr/textAppearanceMedium"
                tools:text="Mode: Walking" />

            <TextView
                android:id="@+id/tv_bottom_journey_start_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:textAppearance="?android:attr/textAppearanceSmall"
                tools:text="Start: 10:00:00 (10 Apr)" />

            <TextView
                android:id="@+id/tv_bottom_journey_end_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:textAppearance="?android:attr/textAppearanceSmall"
                tools:text="End: 10:30:00 (10 Apr)" />

            <TextView
                android:id="@+id/tv_bottom_journey_duration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:textAppearance="?android:attr/textAppearanceSmall"
                tools:text="Duration: 30 min 0 sec" />

            <TextView
                android:id="@+id/tv_bottom_journey_distance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:textAppearance="?android:attr/textAppearanceSmall"
                tools:text="Distance: 1.50 km" />

            <TextView
                android:id="@+id/tv_bottom_journey_accuracy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:textAppearance="?attr/textAppearanceBody2"
                tools:text="Accuracy: 10.5 m" />

            <TextView
                android:id="@+id/tv_bottom_journey_mode_breakdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:textAppearance="?attr/textAppearanceBody2"
                tools:text="Modes: Walking (80%), Still (20%)" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnPrevJourney"
                    style="@style/Widget.AppCompat.Button.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Previous" />

                <Button
                    android:id="@+id/btnNextJourney"
                    style="@style/Widget.AppCompat.Button.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Next" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/btnDeleteJourney"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="0dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="Delete"
                    android:textColor="@android:color/holo_red_dark" />

            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
